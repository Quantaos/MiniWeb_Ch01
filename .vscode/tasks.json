{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Justin Bieber web server",
            "type": "shell",
            "command": "py -m http.server 5500 --directory \"${workspaceFolder}\"",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom-http-server",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Serving HTTP on",
                    "endsPattern": "Serving HTTP on"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "showReuseMessage": false
            }
        }
    ]
}
